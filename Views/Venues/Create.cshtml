@model EventEase.Web.Models.Venue

@{
    ViewData["Title"] = "Create Venue";
}

<section class="form-shell">
    <div class="section-heading">
        <div>
            <p class="eyebrow">New venue</p>
            <h1>Add a venue</h1>
        </div>
        <a class="btn btn-outline-primary" asp-action="Index">Back to list</a>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-grid">
            <div>
                <label asp-for="VenueName" class="form-label"></label>
                <input asp-for="VenueName" class="form-control" />
                <span asp-validation-for="VenueName" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
            <div class="wide-field">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control" type="url" placeholder="https://example.com/image.jpg" />
                <p class="helper-text">This phase uses placeholder image URLs instead of uploads.</p>
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
        </div>

        <div class="actions-row mt-4">
            <button type="submit" class="btn btn-primary">Save venue</button>
            <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
