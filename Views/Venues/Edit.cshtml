@model EventEase.Web.Models.ViewModels.VenueFormViewModel

@{
    ViewData["Title"] = "Edit Venue";
}

<section class="form-shell">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Update venue</p>
            <h1>Edit @Model.VenueName</h1>
        </div>
        <a class="btn btn-outline-primary" asp-action="Index">Back to list</a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input asp-for="VenueId" type="hidden" />
        <partial name="_ValidationAlert" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-grid">
            <div>
                <label asp-for="VenueName" class="form-label"></label>
                <input asp-for="VenueName" class="form-control" />
                <span asp-validation-for="VenueName" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
            <div class="wide-field">
                <div class="form-check mt-4">
                    <input asp-for="IsAvailable" class="form-check-input" />
                    <label asp-for="IsAvailable" class="form-check-label"></label>
                </div>
                <p class="helper-text">Mark a venue unavailable when it should be excluded from new bookings and event filtering.</p>
            </div>
            <div class="wide-field">
                <label asp-for="ImageFile" class="form-label">Picture upload</label>
                <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                <p class="helper-text">Choose a new image file instead of pasting a URL. Leave this empty to keep the current venue image.</p>
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
            <div class="wide-field">
                <label class="form-label">Current image</label>
                <div class="image-preview-shell">
                    <img class="form-image-preview" src="@Model.ExistingImageUrl" alt="@Model.VenueName" />
                </div>
            </div>
        </div>

        <div class="actions-row mt-4">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
