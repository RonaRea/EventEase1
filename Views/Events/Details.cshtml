@model EventEase.Web.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<section class="detail-shell">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Event details</p>
            <h1>@Model.EventName</h1>
            <p class="panel-subtext">@Model.EventDate.ToString("dd MMM yyyy") to @Model.EndDate.ToString("dd MMM yyyy")</p>
        </div>
        <div class="inline-actions">
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.EventId">Edit</a>
            <a class="btn btn-outline-primary" asp-action="Index">Back to list</a>
        </div>
    </div>

    <div class="detail-grid">
        <div class="panel-card">
            <h2>Overview</h2>
            <p>@Model.Description</p>
            <dl class="row mb-0">
                <dt class="col-sm-4">Assigned venue</dt>
                <dd class="col-sm-8">@(Model.Venue?.VenueName ?? "Pending assignment")</dd>
                <dt class="col-sm-4">Booking count</dt>
                <dd class="col-sm-8">@Model.Bookings.Count</dd>
            </dl>
        </div>
        <div class="panel-card">
            <h2>Booking record</h2>
            @if (!Model.Bookings.Any())
            {
                <p class="empty-state">This event has not been booked yet.</p>
            }
            else
            {
                @foreach (var booking in Model.Bookings)
                {
                    <div class="list-item">
                        <div>
                            <h3>#@booking.BookingId</h3>
                            <p>@booking.Venue?.VenueName • booked @booking.BookingDate.ToLocalTime().ToString("dd MMM yyyy")</p>
                        </div>
                        <a class="text-link" asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.BookingId">Open booking</a>
                    </div>
                }
            }
        </div>
    </div>
</section>
