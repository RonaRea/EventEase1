@model EventEase.Web.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<section class="form-shell">
    <div class="section-heading">
        <div>
            <p class="eyebrow">New event</p>
            <h1>Load an event</h1>
        </div>
        <a class="btn btn-outline-primary" asp-action="Index">Back to list</a>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-grid">
            <div class="wide-field">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" class="form-control" type="date" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
            <div class="wide-field">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <p class="helper-text">Venue allocation happens in the booking workflow so this event can exist before a venue is free.</p>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="actions-row mt-4">
            <button type="submit" class="btn btn-primary">Save event</button>
            <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
