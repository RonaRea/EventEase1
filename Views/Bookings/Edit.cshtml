@model EventEase.Web.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
}

<section class="form-shell">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Update booking</p>
            <h1>Edit booking #@Model.BookingId</h1>
        </div>
        <a class="btn btn-outline-primary" asp-action="Index">Back to list</a>
    </div>

    <form asp-action="Edit" method="post">
        <input asp-for="BookingId" type="hidden" />
        <partial name="_ValidationAlert" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-grid">
            <div>
                <label asp-for="EventId" class="form-label"></label>
                <select asp-for="EventId" class="form-select" asp-items="ViewBag.EventId">
                    <option value="">Choose an event</option>
                </select>
                <span asp-validation-for="EventId" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="VenueId" class="form-label"></label>
                <select asp-for="VenueId" class="form-select" asp-items="ViewBag.VenueId">
                    <option value="">Choose a venue</option>
                </select>
                <p class="helper-text">Unavailable venues are excluded unless this booking is already linked to one.</p>
                <span asp-validation-for="VenueId" class="text-danger"></span>
            </div>
            <div>
                <label class="form-label">Booked on</label>
                <input class="form-control" value="@Model.BookingDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")" readonly />
            </div>
        </div>

        <div class="actions-row mt-4">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
